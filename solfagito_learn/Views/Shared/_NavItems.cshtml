@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string controller) =>
        string.Equals(current, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

@* Replace controllers/actions with your own. Icons are Tabler webfont classes. *@

<li class="nav-item">
    <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">
        <span class="nav-icon"><i class="ti ti-layout-dashboard fs-5"></i></span>
        <span class="text">Dashboard</span>
    </a>
</li>

<li class="nav-item">
    <div class="nav-heading">Learn</div>
    <hr class="mx-5 nav-line mb-1" />
</li>

<li class="nav-item">
    <a class="nav-link @Active("Courses")" asp-controller="Courses" asp-action="Index">
        <span class="nav-icon"><i class="ti ti-book fs-5"></i></span>
        <span class="text">Courses</span>
    </a>
</li>

<!-- Dropdown example -->
<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="nav-icon"><i class="ti ti-settings fs-5"></i></span>
        <span class="text">Settings</span>
    </a>
    <ul class="dropdown-menu flex-column">
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">Profile</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
    </ul>
</li>

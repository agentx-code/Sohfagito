@* Desktop mini sidebar + mobile offcanvas share the same items via _NavItems *@

<div id="miniSidebar">
    <div class="brand-logo">
        <a class="d-none d-md-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <img src="~/assets/images/brand/logo/logo-icon.svg" alt="" />
            <span class="fw-bold fs-4 site-logo-text">solfagito</span>
        </a>
    </div>
    <ul class="navbar-nav flex-column">
        <partial name="_NavItems" />
    </ul>
</div>

<div class="offcanvasNav offcanvas offcanvas-start" tabindex="-1" id="offcanvasExample"
     aria-labelledby="offcanvasExampleLabel">
    <div class="offcanvas-header">
        <a class="d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index" id="offcanvasExampleLabel">
            <img src="~/assets/images/brand/logo/logo-icon.svg" alt="" />
            <span class="fw-bold fs-4 site-logo-text">solfagito</span>
        </a>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <ul class="navbar-nav flex-column">
            <partial name="_NavItems" />
        </ul>
    </div>
</div>

@model solfagito_learn.Models.Products.ProductViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Users";
    var page = Model.page;
    var pageSize = Model.pageSize;
    var totalUser = Model.totalItems;
    var Search = Model.search;

    // Calculate dynamic values for the entries info
    int startEntry = ((page - 1) * pageSize) + 1;
    int endEntry = Math.Min(page * pageSize, totalUser);
    if (totalUser == 0) startEntry = 0;
}

<div class="container">
    <div class="form-control">
        <!-- Search and Filter -->
        <div class="toolbar">
            <form asp-action="Products" asp-controller="Admin" method="get">
                <div class="search-box">
                    <input type="search" name="search" id="searchInput" value="@Search" placeholder="Search name, email or role..." aria-label="Search users">
                    <input type="hidden" name="pageSize" value="@pageSize" />
                </div>
            </form>
            <div class="d-flex">
                <div class="entries">
                    <form asp-action="Products" asp-controller="Admin" method="get" id="pageSizeForm">
                        <input type="hidden" name="search" value="@Search" />
                        <select name="pageSize" id="pageSize" onchange="this.form.submit()">
                            <option value="5" selected="@(pageSize == 5 ? "selected" : null)">5</option>
                            <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10</option>
                            <option value="15" selected="@(pageSize == 15 ? "selected" : null)">15</option>
                        </select> Filter
                    </form>
                </div>
            </div>
        </div>

        <!-- Users Table -->
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Sno.</th>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Price</th>
                    <th>Discount Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="usersTable">
                @if (Model.Product != null && Model.Product.Any())
                {
                    int Sno = startEntry;
;

                    foreach (var items in Model.Product)
                    {
                        <tr>
                            <td>@Sno</td>

                            <td>
                                <strong>@items.product_name</strong>
                            </td>

                            <td>@items.sku</td>

                            <td>@items.price.ToString("C")</td>

                            <td>@items.discount_price.ToString("C")</td>

                            <td>@items.stock</td>

                            <td>@items.status</td>

                            <td>
                                @items.created_at.ToString("yyyy-MM-dd")
                            </td>

                            <td class="text-center">
                                <a asp-controller="Admin"
                                asp-action="EditProduct"
                                   asp-route-id="@items.id"
                                class="btn btn-sm btn-primary">
                                    Edit
                                </a>

                                <a asp-controller="Admin"
                                asp-action="DeleteProduct"
                                   asp-route-id="@items.id"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('Are you sure you want to delete this product?');">
                                    Delete
                                </a>
                            </td>
                        </tr>

                        Sno++;
                    }
                }
            </tbody>
        </table>

        <!-- Pagination -->
        <div class="table-footer">
            <div id="tableInfo">
                Showing @startEntry to @endEntry of @totalUser entries
            </div>
            <div class="pagination">
                @{
                    int totalPages = (int)Math.Ceiling((double)totalUser / pageSize);
                    int prevPage = page - 1;
                    int nextPage = page + 1;
                }

                @* <a asp-action="Products" asp-controller="Admin" asp-route-page="@prevPage" asp-route-pageSize="@pageSize" asp-route-search="@Search" class="page-btn @(page <= 1 ? "disabled" : "")">Previous</a> *@

                @for (int i = 1; i <= totalPages; i++)
                {
                    <a asp-action="Products" asp-controller="Admin" asp-route-page="@i" asp-route-pageSize="@pageSize" asp-route-search="@Search" class="page-btn @(page == i ? "active" : "")">@i</a>
                }
    @*              @if (page >= totalPages)
    {
       
                    <a asp-action="Products" asp-controller="Admin" asp-route-page="@nextPage" asp-route-pageSize="@pageSize" asp-route-search="@Search" class="page-btn disabled">Next</a>

                }
    else
    {
                <a asp-action="Products" asp-controller="Admin" asp-route-page="@nextPage" asp-route-pageSize="@pageSize" asp-route-search="@Search" class="page-btn @(page >= totalPages ? "disabled" : "")">Next</a>
    }  *@
    </div>
        </div>
    </div>
</div>
